# ---------------------------------------------------------------------------
# Aegis 2FA 同步服务配置
#
# 复制为 .env 后填入真实值。.env 已被 .gitignore 排除,切勿提交。
# 这里只提供占位值说明,不含任何真实密钥。
#
# 【服务已切换为 Go 实现】构建产物为单个静态二进制,无 Node 运行时依赖。
#   构建: npm run build:server      (等价于 go build -o server-go/dist/aegis-server ./cmd/aegis-server)
#   启动: npm run start:server      (等价于 ./server-go/dist/aegis-server)
#
#   Windows 下需把 Go 加入 PATH:
#     export PATH="$PATH:/c/Program Files/Go/bin"
#   国内网络需要配置代理(proxy.golang.org 直连会返回 502):
#     go env -w GOPROXY=https://goproxy.cn,https://mirrors.aliyun.com/goproxy/,direct
# ---------------------------------------------------------------------------

# 运行环境:development | production
# 生产环境会启用更严格的校验(拒绝通配 CORS、强制长密钥)
# AEGIS_ENV 是 Go 版的主变量名;NODE_ENV 作为兼容项保留,
# 便于同一份 .env 在迁移期同时供旧 Node 版与新 Go 版使用。
AEGIS_ENV=development

# 监听地址与端口
# 生产环境若由 Nginx/Caddy 反代,建议保持监听 127.0.0.1
HOST=127.0.0.1
PORT=8787

# ---------------------------------------------------------------------------
# 令牌签名密钥 【必填】
#
# 生成方式:
#   openssl rand -hex 32
#
# 安全性说明:
#   这个密钥只用于签发"同步服务访问令牌"(决定把哪份密文发给谁),
#   它【不是】用户的主密码,也【无法】解密任何保险库内容。
#   即便密钥泄露,攻击者也无法解读密文——但仍可越权拉取他人密文,
#   因此仍需保密,并在泄露时轮换。
#
#   生产环境要求至少 32 字符,否则拒绝启动。
# ---------------------------------------------------------------------------
AEGIS_TOKEN_SECRET=请替换为openssl_rand_hex_32生成的随机值

# 数据目录:存放 SQLite 库(vaults.db)与凭据文件(credentials.json)
# 生产环境请放在持久化磁盘上,并纳入备份策略
# 两个文件都需要备份,缺一不可
AEGIS_DATA_DIR=./server-go/data

# ---------------------------------------------------------------------------
# CORS 白名单 【必填】
#
# 逗号分隔的完整来源,不要带结尾斜杠。
# 显式白名单而非通配 *,是因为浏览器扩展与 Web 端来源不同,
# 混用通配会让任一站点都能读取同步接口。
#
# 示例:
#   小程序开发:https://servicewechat.com
#   本地 Web:http://localhost:5173
#   线上 Web:https://2fa.yourdomain.com
# ---------------------------------------------------------------------------
AEGIS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 访问令牌有效期(秒)。默认 1 小时。
# 客户端会在过期前自动用刷新令牌续期,用户无感。
AEGIS_TOKEN_TTL=3600
