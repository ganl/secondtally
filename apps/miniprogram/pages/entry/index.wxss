.page { min-height: 100vh; background: #0f172a; padding: 0 32rpx 64rpx; }

.code-hero {
  background: #1e293b;
  border-radius: 24rpx;
  padding: 56rpx 32rpx;
  text-align: center;
  margin: 32rpx 0;
}

.code-value {
  font-family: 'SF Mono', Menlo, monospace;
  font-size: 76rpx;
  color: #f8fafc;
  letter-spacing: 8rpx;
  font-weight: 600;
}
.code-expired { color: #475569; }
.code-sep { color: #475569; letter-spacing: 0; }

.progress-track {
  height: 8rpx; background: #334155; border-radius: 4rpx;
  margin: 32rpx 0 16rpx; overflow: hidden;
}
.progress-fill { height: 100%; background: #6366f1; transition: width 0.5s linear; }
.progress-fill-urgent { background: #f59e0b; }

.seconds { font-size: 24rpx; color: #64748b; }
.copy-hint { font-size: 24rpx; color: #64748b; margin-top: 24rpx; }

.card { background: #1e293b; border-radius: 20rpx; padding: 32rpx; margin-bottom: 24rpx; }
.row { display: flex; justify-content: space-between; padding: 22rpx 0; border-bottom: 1rpx solid #334155; }
.row:last-child { border-bottom: none; }
.row-label { font-size: 26rpx; color: #94a3b8; }
.row-value { font-size: 26rpx; color: #f8fafc; max-width: 60%; text-align: right; word-break: break-all; }
.mono { font-family: 'SF Mono', Menlo, monospace; }
.btn { background: #6366f1; color: #fff; border-radius: 16rpx; padding: 28rpx; font-size: 30rpx; text-align: center; }
.btn-ghost {
  background: transparent; color: #94a3b8; border: 2rpx solid #334155;
  border-radius: 16rpx; padding: 24rpx; font-size: 28rpx; text-align: center; margin-top: 20rpx;
}
.btn-danger { background: #7f1d1d; color: #fecaca; }
.warn { font-size: 24rpx; color: #f59e0b; line-height: 1.6; margin-top: 20rpx; }
