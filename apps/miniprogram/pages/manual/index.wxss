.page {
  min-height: 100vh;
  background: #0f172a;
  padding: 0 32rpx 64rpx;
}

.hero { padding: 56rpx 0 32rpx; }
.title { font-size: 40rpx; color: #f8fafc; font-weight: 600; }

.card {
  background: #1e293b;
  border-radius: 20rpx;
  padding: 36rpx;
  margin-bottom: 24rpx;
}

.label { font-size: 26rpx; color: #cbd5e1; margin-bottom: 14rpx; display: block; }
.input {
  background: #0f172a;
  border-radius: 14rpx;
  padding: 24rpx;
  color: #f8fafc;
  font-size: 30rpx;
  border: 2rpx solid #334155;
  margin-bottom: 28rpx;
}
.mono { font-family: 'SF Mono', Menlo, monospace; letter-spacing: 2rpx; }
.hint { font-size: 24rpx; color: #64748b; line-height: 1.6; margin-top: 8rpx; margin-bottom: 28rpx; }
.error {
  background: rgba(239,68,68,0.12);
  border: 2rpx solid #7f1d1d;
  border-radius: 12rpx;
  padding: 18rpx 22rpx;
  color: #fca5a5;
  font-size: 25rpx;
  margin-bottom: 24rpx;
}
.btn {
  background: #6366f1; color: #fff; border-radius: 16rpx;
  padding: 28rpx; font-size: 30rpx; text-align: center;
}
.btn-disabled { background: #334155; color: #64748b; }
.row { display: flex; gap: 20rpx; }
.row-item { flex: 1; }
.picker {
  background: #0f172a; border-radius: 14rpx; padding: 24rpx;
  color: #f8fafc; font-size: 30rpx; border: 2rpx solid #334155; margin-bottom: 28rpx;
}
