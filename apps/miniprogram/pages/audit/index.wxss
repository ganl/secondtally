.page { min-height: 100vh; background: #0f172a; }
.hero { padding: 48rpx 32rpx 24rpx; }
.title { font-size: 40rpx; color: #f8fafc; font-weight: 600; }
.desc { font-size: 24rpx; color: #64748b; margin-top: 12rpx; line-height: 1.6; }
.item { padding: 24rpx 32rpx; border-bottom: 1rpx solid #1e293b; }
.item-head { display: flex; justify-content: space-between; align-items: center; }
.item-action { font-size: 27rpx; color: #f8fafc; }
.item-time { font-size: 22rpx; color: #475569; }
.item-detail { font-size: 24rpx; color: #64748b; margin-top: 8rpx; }
.badge { font-size: 20rpx; padding: 4rpx 12rpx; border-radius: 8rpx; margin-left: 12rpx; }
.badge-success { background: rgba(34,197,94,0.15); color: #86efac; }
.badge-denied { background: rgba(239,68,68,0.15); color: #fca5a5; }
.badge-error { background: rgba(245,158,11,0.15); color: #fcd34d; }
.empty { padding: 120rpx 64rpx; text-align: center; color: #64748b; font-size: 26rpx; }
.privacy {
  margin: 32rpx; padding: 28rpx; background: #1e293b;
  border-radius: 16rpx; font-size: 24rpx; color: #94a3b8; line-height: 1.7;
}
