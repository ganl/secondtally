.page { min-height: 100vh; background: #0f172a; padding: 0 32rpx 64rpx; }
.hero { padding: 56rpx 0 32rpx; }
.title { font-size: 40rpx; color: #f8fafc; font-weight: 600; }
.card { background: #1e293b; border-radius: 20rpx; padding: 36rpx; margin-bottom: 24rpx; }
.label { font-size: 26rpx; color: #cbd5e1; margin-bottom: 14rpx; display: block; }
.value { font-size: 32rpx; color: #f8fafc; word-break: break-all; }
.hint { font-size: 24rpx; color: #64748b; line-height: 1.6; margin-top: 20rpx; }
.error {
  background: rgba(239,68,68,0.12); border: 2rpx solid #7f1d1d;
  border-radius: 12rpx; padding: 18rpx 22rpx; color: #fca5a5; font-size: 25rpx; margin-bottom: 24rpx;
}
.success {
  background: rgba(34,197,94,0.1); border: 2rpx solid #14532d;
  border-radius: 12rpx; padding: 18rpx 22rpx; color: #86efac; font-size: 25rpx; margin-bottom: 24rpx;
}
.notice {
  background: rgba(245,158,11,0.1); border: 2rpx solid #78350f;
  border-radius: 12rpx; padding: 20rpx 24rpx; color: #fcd34d;
  font-size: 24rpx; line-height: 1.6; margin-bottom: 32rpx;
}
.btn { background: #6366f1; color: #fff; border-radius: 16rpx; padding: 28rpx; font-size: 30rpx; text-align: center; }
.btn-ghost {
  background: transparent; color: #94a3b8; border: 2rpx solid #334155;
  border-radius: 16rpx; padding: 24rpx; font-size: 28rpx; text-align: center; margin-top: 24rpx;
}
.btn-danger { background: #7f1d1d; color: #fecaca; }
.code-list { margin: 24rpx 0; }
.code-item {
  font-family: 'SF Mono', Menlo, monospace;
  font-size: 34rpx; color: #f8fafc;
  padding: 18rpx 0; border-bottom: 1rpx solid #334155;
  letter-spacing: 2rpx;
}
.code-item:last-child { border-bottom: none; }
.progress { height: 8rpx; background: #334155; border-radius: 4rpx; margin: 32rpx 0; overflow: hidden; }
.progress-fill { height: 100%; background: #6366f1; }
.stat-row { display: flex; justify-content: space-between; padding: 20rpx 0; border-bottom: 1rpx solid #334155; }
.stat-label { font-size: 26rpx; color: #94a3b8; }
.stat-value { font-size: 26rpx; color: #f8fafc; }
