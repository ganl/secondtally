.page {
  min-height: 100vh;
  background: #0f172a;
  padding: 0 32rpx 64rpx;
}

.hero {
  padding: 64rpx 0 40rpx;
}

.title {
  font-size: 40rpx;
  color: #f8fafc;
  font-weight: 600;
}

.desc {
  font-size: 26rpx;
  color: #94a3b8;
  margin-top: 16rpx;
  line-height: 1.6;
}

.action-card {
  background: #1e293b;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 24rpx;
  text-align: center;
}

.action-icon {
  font-size: 64rpx;
  margin-bottom: 20rpx;
}

.action-title {
  font-size: 32rpx;
  color: #f8fafc;
  font-weight: 500;
}

.action-desc {
  font-size: 24rpx;
  color: #64748b;
  margin-top: 12rpx;
  line-height: 1.6;
}

.btn {
  background: #6366f1;
  color: #fff;
  border-radius: 16rpx;
  padding: 26rpx;
  font-size: 30rpx;
  text-align: center;
  margin-top: 28rpx;
}

.section-title {
  font-size: 26rpx;
  color: #64748b;
  margin: 40rpx 0 20rpx;
}

.tip {
  background: #1e293b;
  border-radius: 16rpx;
  padding: 28rpx;
  font-size: 24rpx;
  color: #94a3b8;
  line-height: 1.7;
}
